# syntax=docker/dockerfile:1
#
# GraalVM native image: the application compiled to a native executable, no JVM in the image.
#
#   docker build -f Dockerfile.native -t resourceapi:native .
#   docker run --rm -p 8080:8080 resourceapi:native
#
# The build needs about 10 GB of memory for Docker (see docs/native-image.md#build-memory) and
# produces an executable for the build platform's architecture (e.g. linux/amd64).

FROM ghcr.io/graalvm/native-image-community:25 AS build
WORKDIR /workspace

COPY .mvn/ .mvn/
COPY mvnw pom.xml ./
RUN --mount=type=cache,target=/root/.m2 ./mvnw -B -q dependency:go-offline

COPY src/ src/
RUN --mount=type=cache,target=/root/.m2 ./mvnw -B -q -Pnative -DskipTests native:compile

# Small glibc-based image (the executable links against glibc and zlib)
FROM debian:bookworm-slim
RUN useradd --system --uid 1001 --no-create-home spring
COPY --from=build /workspace/target/resourceapi /app/resourceapi

USER spring
EXPOSE 8080
ENTRYPOINT ["/app/resourceapi"]
